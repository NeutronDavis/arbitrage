# ── RPC endpoints ──────────────────────────────────────────────────────────────
# HTTP endpoint for one-shot calls (QuoterV2, getReserves, etc.)
ARBITRUM_RPC_HTTP=https://arb-mainnet.g.alchemy.com/v2/ZyLnycsDoKDatxe3CqKSUhnMnOY50Tph

# WebSocket endpoint for block subscriptions
ARBITRUM_RPC_WS=wss://arb-mainnet.g.alchemy.com/v2/ZyLnycsDoKDatxe3CqKSUhnMnOY50Tph

# ── Execution (Phase 5 only) ───────────────────────────────────────────────────
# Set to "true" only when you are ready to send live transactions.
# Stays "false" throughout Phases 1-4.
EXECUTION_ENABLED=false

# Deployed contract address (filled in after Phase 5 deployment)
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Private key — NEVER commit a real value.  Load from a secrets manager.
# Phase 1-3: not read by the bot.  Phase 4+: loaded only when EXECUTION_ENABLED=true.
# PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── Profit threshold ────────────────────────────────────────────────────────────
# Minimum net profit in WETH (18-decimal wei string) before the bot acts.
MIN_PROFIT_WEI=1000000000000000
